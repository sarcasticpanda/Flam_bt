# THE———BOARD — copy to .env and fill in. Server-side only.
#
# RULE: if you ever see any key below prefixed with VITE_, stop and fix it.
# Anything VITE_-prefixed is compiled into the client bundle and shipped to every visitor.

PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# AI providers — all three have a free tier. The server tries them in order and
# falls through on failure. `demo` is a deterministic local generator that needs
# no network at all, so the app never hard-fails in front of a reviewer.
# ---------------------------------------------------------------------------
AI_PROVIDER_ORDER=groq,gemini,openrouter,demo

# console.groq.com/keys — free, no card
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# aistudio.google.com/apikey — free, no card.
# Use the `-latest` alias: dated Gemini slugs get retired for new users without notice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# openrouter.ai/keys — free tier. Free slugs churn; verify with
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Gemini/Nemotron are THINKING models — they spend output budget on reasoning before
# emitting a token of JSON. 2000 returned empty content. Do not lower.
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=30000
AI_RATE_ROOM_PER_MIN=20
AI_RATE_USER_PER_HOUR=60
AI_MAX_INPUT_CHARS=12000

# ---------------------------------------------------------------------------
# Persistence — leave DATABASE_URL blank to use local SQLite.
# ---------------------------------------------------------------------------
DATABASE_URL=
SQLITE_PATH=./data/board.db

# Optional. Without these, uploads go to local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=the-board

MAX_FILE_MB=10
MAX_BOARD_MB=100
